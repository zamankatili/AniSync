# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase config (Vite env vars). Values here override firebase-applet-config.json.
# Obtain these from your Firebase project settings (General > Your apps > Web app).
# VITE_FIREBASE_API_KEY="MY_FIREBASE_API_KEY"
# VITE_FIREBASE_AUTH_DOMAIN="MY_PROJECT.firebaseapp.com"
# VITE_FIREBASE_PROJECT_ID="MY_FIREBASE_PROJECT_ID"
# VITE_FIREBASE_STORAGE_BUCKET="MY_PROJECT.appspot.com"
# VITE_FIREBASE_MESSAGING_SENDER_ID="MY_SENDER_ID"
# VITE_FIREBASE_APP_ID="1:MY_SENDER_ID:web:MY_APP_ID"
# VITE_FIREBASE_MEASUREMENT_ID="MY_MEASUREMENT_ID"
# VITE_FIRESTORE_DATABASE_ID="(default)"

# Google sign-in (native/web). Configure OAuth client IDs in Firebase Console
# and Google Cloud Console, then enable the Google sign-in provider.
# VITE_GOOGLE_WEB_CLIENT_ID="MY_GOOGLE_WEB_CLIENT_ID"
# VITE_GOOGLE_IOS_CLIENT_ID="MY_GOOGLE_IOS_CLIENT_ID"
# VITE_GOOGLE_ANDROID_CLIENT_ID="MY_GOOGLE_ANDROID_CLIENT_ID"

# Admin bootstrap (ilk admin). Virgülle ayırın; kurallar tarafında da aynı listeyi
# görüyorsunuz. İlk admin olduktan sonra users/{uid}.role='admin' yapın ve bu listeyi silin.
# Örnek: VITE_ADMIN_EMAILS="admin1@example.com,admin2@example.com"
VITE_ADMIN_EMAILS="zamankatilii@gmail.com"

# ─── Sunucu tarafı (server.ts / Vercel fonksiyonları) ────────────────
# Vercel Cron'un /api/refresh-news'i çağırması için paylaşılan sır.
# `vercel.json`'daki "crons" ile birlikte set edin; Vercel, `Authorization: Bearer <CRON_SECRET>`
# başlığını otomatik gönderir. Tanımsızsa endpoint kimliksiz çalışır (yalnızca yerel).
# CRON_SECRET="rastgele-uzun-sır"

# Firebase proje kimliği — API uçlarında ID token doğrulaması için kullanılır
# (istemci token'ının `aud` değeri). Üretimde zorunlu; yoksa public projectId kullanılır.
# FIREBASE_PROJECT_ID="folkloric-centaur-q6tp2"

# ─── Ölçüm / hata izleme / kötüye kullanım koruması ─────────────────────────
# Ayrıntılı kurulum: docs/observability.md
# Hiçbiri zorunlu değil; tanımsızsa ilgili katman sessizce kapalı çalışır.

# GA4 ölçüm kimliği. Tanımlıysa ziyaretçiye KVKK rıza bandı çıkar.
# VITE_GA4_ID="G-XXXXXXXXXX"

# Sentry DSN. Tanımlıysa SDK dinamik yüklenir (ilk paket büyümez).
# VITE_SENTRY_DSN="https://examplePublicKey@o0.ingest.sentry.io/0"
# VITE_SENTRY_RELEASE="<commit sha>"

# Firebase App Check (reCAPTCHA v3 site anahtarı). Enforcement'ı en son aç!
# VITE_RECAPTCHA_SITE_KEY="6Lc..."
# VITE_APPCHECK_DEBUG_TOKEN="true"   # yalnızca yerel geliştirme

# Hız sınırı için dağıtık sayaç (önerilir). Tanımsızsa bellek içi sayaç kullanılır.
# UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="AX..."
# RATE_LIMIT_DISABLED="1"            # yalnızca yerel geliştirme

