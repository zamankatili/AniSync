rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ─── Admin bootstrap: ilk adminın e-postası (kuralları düzenleyerek veya
    //     `users/{uid}` rolüyle yönetin; sonradan bu listeyi daraltın/silin) ───
    function isBootstrapAdminEmail() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['zamankatilii@gmail.com'];
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function hasRole(role) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().data.role == role;
    }
    // Moderatör: içerik silme/banlama yetkisi; config/flag/announcement değiştirme sadece admin
    function isAdmin() {
      return isBootstrapAdminEmail() || hasRole('admin') || hasRole('moderator');
    }
    function isAdminOnly() {
      return isBootstrapAdminEmail() || hasRole('admin');
    }
    function affectedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ─── Admin & sistem ─────────────────────────────────────
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdminOnly();
    }
    match /adminActions/{doc} {
      allow read: if isAdmin();
      allow write: if isAdminOnly();
    }
    match /reports/{doc} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
    // KVKK/GDPR veri talepleri: kullanıcı yalnız kendi adına oluşturabilir; işleme admin
    match /dataRequests/{doc} {
      allow read: if isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.type in ['export', 'delete']
        && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }

    // ─── Kullanıcı profili ────────────────────────────────────
    // ÖNEMLİ: hiçbir kullanıcı kendi `role`/`banUntil`/`banReason` alanını yazamaz.
    // Admin, ban (banUntil/banReason) alanlarını değiştirebilir; `role` sadece admin-only admin.
    match /users/{uid} {
      allow read: if true;
      // Oluşturma: rol/ban alanları yok sayılır (yetki yükseltme koruması)
      allow create: if isSignedIn() && request.auth.uid == uid
        && !request.resource.data.keys().hasAny(['role', 'banUntil', 'banReason']);
      // Sahip güncellemesi: rol/ban alanlarına dokunamaz
      allow update: if isSignedIn() && request.auth.uid == uid
        && !affectedKeys().hasAny(['role', 'banUntil', 'banReason']);
      // Moderatör/admin: SADECE ban alanları değiştirebilir
      allow update: if isAdmin()
        && affectedKeys().hasOnly(['banUntil', 'banReason']);
      // Admin: her şey (role dahil)
      allow update: if isAdminOnly();
      allow delete: if isAdminOnly();

      match /watchlist/{mal_id} {
        allow read: if true;
        allow write: if isSignedIn() && request.auth.uid == uid;
      }
      match /reminders/{id} {
        allow read: if isSignedIn() && request.auth.uid == uid;
        allow write: if isSignedIn() && request.auth.uid == uid;
      }
      match /customData/{id} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    // ─── Anketler: içerik admin tarafında yayınlanır; oy sayacı +1/oy yazımı imzalı herkese açık ───
    match /polls/{id} {
      allow read: if true;
      allow create, delete: if isAdminOnly();
      // Sayaç güncellemesi: yalnız `votes` haritası; mevcut seçenek anahtarları korunur,
      // yeni anahtar eklenemez/çıkarılamaz. (Tek oy kuralı istemci transaction'ı + votes/{uid} ile.)
      allow update: if isAdminOnly()
        || (isSignedIn()
            && affectedKeys().hasOnly(['votes'])
            && request.resource.data.votes is map
            && request.resource.data.votes.keys().hasAll(resource.data.votes.keys())
            && request.resource.data.votes.keys().hasOnly(resource.data.votes.keys()));

      match /votes/{uid} {
        allow read: if true;
        allow create, update: if isSignedIn() && request.auth.uid == uid
          && request.resource.data.optionId is string;
        allow delete: if isAdmin();
      }
    }
    match /suggestedPolls/{id} { allow read: if isAdmin(); allow create: if isSignedIn(); allow update, delete: if isAdmin(); }

    // ─── Forum: yazar veya moderatör/admin ─────────────────────
    match /forumPosts/{id} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.author.uid == request.auth.uid;
      // Yazar her şeyi; diğer imzalı kullanıcılar SADECE like/yorum alanlarını değiştirebilir
      allow update: if isAdmin()
        || (isSignedIn() && resource.data.author.uid == request.auth.uid)
        || (isSignedIn() && affectedKeys().hasOnly(['likedBy', 'likes', 'comments', 'replies']));
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.author.uid == request.auth.uid);
    }

    // ─── Topluluk aktiviteleri: sadece kendi adına yazma ───────
    match /recentActivities/{id} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdminOnly();
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // ─── Anime yorumları ───────────────────────────────────────
    // Yıldız puanları: `animeRatings/{animeId}` özet + `ratings/{uid}` tek oy.
    // Özet dokümanı istemci transaction ile günceller; değerler aralık dışına çıkamaz.
    match /animeRatings/{animeId} {
      allow read: if true;
      allow create, update: if isSignedIn()
        && request.resource.data.averageRating is number
        && request.resource.data.averageRating >= 0
        && request.resource.data.averageRating <= 5
        && request.resource.data.totalRatings is int
        && request.resource.data.totalRatings >= 0
        && (!request.resource.data.keys().hasAny(['sumRatings']) || request.resource.data.sumRatings is number);
      allow delete: if isAdminOnly();

      match /ratings/{uid} {
        allow read: if true;
        allow create, update: if isSignedIn() && request.auth.uid == uid
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5;
        allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      }
    }

    // Chat canlı etkinlik RSVP'leri: everyone reads count; only own write
    match /chatEventRsvps/{uid} {
      allow read: if true;
      allow create, update, delete: if isSignedIn() && request.auth.uid == uid;
    }

    match /animeComments/{id} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid
        && request.resource.data.content is string
        && request.resource.data.content.size() <= 2000;
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // ─── Anime incelemeleri: yazar tam yetki; herkes sadece like alanını değiştirebilir ───
    match /animeReviews/{animeId}/userReviews/{uid} {
      allow read: if true;
      allow write: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow update: if isAdmin()
        || (isSignedIn() && affectedKeys().hasOnly(['likes', 'likedBy']));
    }

    // ─── Özel listeler: `creatorId` alanı ──────────────────────
    match /customLists/{id} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.creatorId == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.creatorId == request.auth.uid);
    }

    // ─── Sosyal akış ───────────────────────────────────────────
    match /socialFeed/{id} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      // Yazar her şeyi; diğer imzalı kullanıcılar SADECE like alanlarını değiştirebilir
      allow update: if isAdmin()
        || (isSignedIn() && resource.data.userId == request.auth.uid)
        || (isSignedIn() && affectedKeys().hasOnly(['likedBy', 'likes']));
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // ─── Genel sohbet: `uid` alanı ─────────────────────────────
    match /globalChat/{id} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 500;
      allow update: if isAdminOnly();
      allow delete: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    // ─── Kozmik sohbet odaları (resmi + topluluk) ──────────────
    // okuma imzalı kullanıcılara; oda açma: Kalfa+ (istemcide uygulanır) + AI filtresi;
    // istek odası: 50 oy + moderatör onayı; yalnızca kendi uid'i ile oy verilebilir.
    function isValidRoom(data) {
      return data.keys().hasOnly(['name', 'topic', 'icon', 'createdAt', 'createdBy', 'karmaAtCreation', 'source'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 40
        && data.topic is string && data.topic.size() <= 160
        && data.icon is string && data.icon.size() > 0 && data.icon.size() <= 8
        && data.createdBy.name is string
        && data.karmaAtCreation is int
        && data.source in ['direct', 'approved']
        // Doğrudan oda: kullanıcı yalnız kendi adına açar.
        // Onaylı oda: moderatör, isteği onaylarken istek sahibi adına oluşturur.
        && (
          (data.source == 'direct' && data.createdBy.uid == request.auth.uid)
          || (data.source == 'approved' && isAdmin())
        );
    }
    function isValidRoomRequest(data) {
      return data.keys().hasOnly(['name', 'topic', 'icon', 'requestedBy', 'status', 'votes', 'voters', 'createdAt', 'aiVerdict', 'aiReason', 'modNote', 'approvedBy', 'approvedAt', 'rejectedBy'])
        && data.name is string && data.name.size() > 0 && data.name.size() <= 40
        && data.topic is string && data.topic.size() <= 160
        && data.icon is string && data.icon.size() > 0 && data.icon.size() <= 8
        && data.requestedBy.uid == request.auth.uid
        && data.requestedBy.name is string
        && data.requestedBy.karma is int;
    }

    match /chatRooms/{id} {
      allow read: if true;
      allow create: if isSignedIn() && isValidRoom(request.resource.data);
      allow update, delete: if isAdmin();
    }
    match /roomRequests/{id} {
      allow read: if true;
      allow create: if isSignedIn()
        && isValidRoomRequest(request.resource.data)
        && request.resource.data.status == 'pending'
        && request.resource.data.votes == 0
        && request.resource.data.voters == []
        && request.resource.data.aiReason is string
        && request.resource.data.aiReason.size() <= 220;
      // Oy verme: yalnızca kendi uid eklenir; tek oy; status değişmez
      allow update: if isSignedIn()
        && resource.data.status == 'pending'
        && affectedKeys().hasOnly(['voters', 'votes'])
        && request.resource.data.voters == resource.data.voters.concat([request.auth.uid])
        && !resource.data.voters.hasAny([request.auth.uid])
        && request.resource.data.votes == resource.data.votes + 1;
      // Moderatör/admin onayı/reddi + notu
      allow update: if isAdmin() && affectedKeys().hasOnly(['status', 'modNote', 'approvedBy', 'approvedAt', 'rejectedBy']);
      allow delete: if isAdmin();
    }

    // ─── İzleme partisi odaları ────────────────────────────────
    match /watchPartyRooms/{id} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.hostId == request.auth.uid;
      // Oynatma senkronu: host/admin her alanı; diğer imzalı kullanıcılar yalnız
      // kilit açıkken oynatma zamanını değiştirebilir. videoId/title/lock host'a kapalıdır.
      allow update: if isAdmin()
        || (isSignedIn() && resource.data.hostId == request.auth.uid)
        || (isSignedIn()
            && resource.data.isLocked != true
            && affectedKeys().hasOnly(['isPlaying', 'currentTime', 'updatedAt'])
            && request.resource.data.currentTime is int
            && request.resource.data.currentTime >= 0
            && request.resource.data.currentTime <= 86400);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.hostId == request.auth.uid);

      match /messages/{mid} {
        allow read: if true;
        allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid
          && request.resource.data.text.size() <= 500;
        allow delete: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      }
      match /reactions/{rid} {
        allow read: if true;
        allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
        allow delete: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      }
    }

    // ─── Anma defteri (paylaşılan hayatlar) ─────────────────────
    // Oluşturma: giriş zorunlu + userId uyumu + candles=0 + bilinen alanlar.
    // Güncelleme: imzalı kullanıcılar SADECE mum sayısını +1 artırabilir; admin her şeyi yapar.
    match /sharedLives/{id} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.candles == 0
        && request.resource.data.keys().hasOnly([
             'characterName', 'worldEmoji', 'worldNameTR', 'worldNameEN',
             'regionNameTR', 'regionNameEN', 'deathAge', 'birthYear', 'deathCause',
             'power', 'intelligence', 'luck', 'socialClass', 'health',
             'eventsCount', 'candles', 'createdAt', 'userId'
           ]);
      allow update: if isAdminOnly()
        || (isSignedIn()
            && affectedKeys().hasOnly(['candles'])
            && request.resource.data.candles is int
            && request.resource.data.candles == resource.data.candles + 1);
      allow delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // ─── Haberler: yalnız admin yayınlar ───────────────────────
    match /animeNews/{id} {
      allow read: if true;
      allow write: if isAdminOnly();
    }

    // Varsayılan: kapalı (geri kalan her şey reddedilir)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
