rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ─── Admin bootstrap: ilk adminın e-postası (kuralları düzenleyerek veya
    //     `users/{uid}` rolüyle yönetin; sonradan bu listeyi daraltın/silin) ───
    function isBootstrapAdminEmail() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email in ['zamankatilii@gmail.com'];
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isBootstrapAdminEmail()
        || (isSignedIn()
            && exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
                || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'moderator'));
    }
    // Moderatör: sadece report içeriğini silme/banlama yetkisi; config/flag değiştirme sadece admin
    function isAdminOnly() {
      return isBootstrapAdminEmail()
        || (isSignedIn()
            && exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // ─── Admin & sistem ─────────────────────────────────────
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdminOnly();
    }
    match /adminActions/{doc} {
      allow read: if isAdminOnly();
      allow write: if isAdminOnly();
    }
    match /reports/{doc} {
      allow read: if isAdminOnly();
      allow create: if isSignedIn();
      allow update, delete: if isAdminOnly();
    }

    // ─── Yer tutucu tanımlar (uygulama şeması) ─────────────────
    match /users/{uid} {
      allow read: if true;
      allow create, update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if isAdminOnly();
      // `role` alanı yalnız admin tarafından değiştirilebilir
      allow update: if isAdminOnly()
        && request.resource.data.keys().hasOnly(['name', 'handle', 'photoURL', 'banUntil', 'banReason', 'role', 'namedLists', 'joinedAt']);

      match /watchlist/{mal_id} {
        allow read: if true;
        allow write: if isSignedIn() && request.auth.uid == uid;
      }
      match /reminders/{id} {
        allow read: if isSignedIn() && request.auth.uid == uid;
        allow write: if isSignedIn() && request.auth.uid == uid;
      }
      match /customData/{id} {
        allow read, write: if isSignedIn() && request.auth.uid == uid;
      }
    }

    // ─── Topluluk içeriği (herkes okur, giriş yapmış yazar, admin siler) ──────
    match /polls/{id}          { allow read: if true; allow create: if isSignedIn(); allow update, delete: if isAdminOnly(); }
    match /suggestedPolls/{id} { allow read: if isAdminOnly(); allow create: if isSignedIn(); allow update, delete: if isAdminOnly(); }
    match /forumPosts/{id}     { allow read: if true; allow create: if isSignedIn(); allow update, delete: if isSignedIn() && request.resource.data.userId == request.auth.uid || isAdminOnly(); }
    match /recentActivities/{id} { allow read: if true; allow create: if isSignedIn(); allow update, delete: if isAdminOnly(); }
    match /animeComments/{id}  { allow read: if true; allow create: if isSignedIn(); allow update, delete: if isSignedIn() && request.resource.data.userId == request.auth.uid || isAdminOnly(); }
    match /animeReviews/{animeId}/userReviews/{uid} { allow read: if true; allow write: if isSignedIn() && request.auth.uid == uid; }
    match /customLists/{id}    { allow read: if true; allow create: if isSignedIn(); allow update, delete: if isSignedIn() && request.resource.data.userId == request.auth.uid || isAdminOnly(); }
    match /socialFeed/{id}     { allow read: if true; allow create: if isSignedIn(); allow update, delete: if isSignedIn() && request.resource.data.userId == request.auth.uid || isAdminOnly(); }
    match /globalChat/{id}     { allow read: if true; allow create: if isSignedIn(); allow update, delete: if isAdminOnly(); }
    match /watchPartyRooms/{id} { allow read: if true; allow create, update: if isSignedIn(); allow delete: if isAdminOnly(); }
    match /watchPartyRooms/{id}/messages/{mid} { allow read: if true; allow create: if isSignedIn(); allow update, delete: if isAdminOnly() || (isSignedIn() && request.resource.data.userId == request.auth.uid); }
    match /sharedLives/{id}    { allow read: if true; allow create: if isSignedIn(); allow update, delete: if isAdminOnly(); }
    match /animeNews/{id}      { allow read: if true; allow create, update, delete: if isAdminOnly(); }

    // Varsayılan: kapalı (geri kalan her şey reddedilir)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
